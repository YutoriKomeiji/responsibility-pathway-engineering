{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YutoriKomeiji/responsibility-pathway-engineering/blob/main/schemas/external-kernel/governed-evaluation-request.schema.json",
  "title": "RPE Governed Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request", "governed_packs"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "request": {
      "allOf": [
        {"$ref": "action-request.schema.json"},
        {"required": ["contract_version"]}
      ]
    },
    "governed_packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "governed-pack-binding.schema.json"}
    }
  }
}
