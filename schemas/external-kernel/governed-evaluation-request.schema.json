{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YutoriKomeiji/responsibility-pathway-engineering/blob/main/schemas/external-kernel/governed-evaluation-request.schema.json",
  "title": "RPE Governed Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request", "governed_packs"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "request": {
      "allOf": [
        {"$ref": "action-request.schema.json"},
        {"required": ["contract_version"]}
      ]
    },
    "governed_packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "governed-pack-binding.schema.json"}
    },
    "transport_provenance": {"$ref": "#/$defs/transport_provenance"}
  },
  "$defs": {
    "transport_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "content_sha256", "byte_length", "observation_scope"],
      "properties": {
        "source_kind": {"type": "string", "enum": ["caller_content", "local_file"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "observation_scope": {"const": "transport_bytes_only"}
      }
    }
  }
}
