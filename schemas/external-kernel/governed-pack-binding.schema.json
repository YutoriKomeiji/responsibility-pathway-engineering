{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YutoriKomeiji/responsibility-pathway-engineering/blob/main/schemas/external-kernel/governed-pack-binding.schema.json",
  "title": "RPE Governed Requirement Pack Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "binding_id",
    "pack",
    "governance"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "pack": {
      "allOf": [
        {
          "$ref": "requirement-pack.schema.json"
        },
        {
          "required": [
            "contract_version"
          ]
        }
      ]
    },
    "governance": {
      "allOf": [
        {
          "$ref": "requirement-pack-governance.schema.json"
        },
        {
          "required": [
            "contract_version"
          ]
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
