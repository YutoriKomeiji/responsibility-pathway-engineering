{
  "openapi": "3.1.0",
  "info": {
    "title": "RPE Kernel Guarded Transition API",
    "version": "0.2.0-exp",
    "description": "Experimental evaluation-only guarded responsibility-transition contract. Guard observations are caller-supplied bounded evidence. This API does not authenticate identities, validate organizational authority, certify human capability, establish evidence truth, dispatch actions, verify external effects, or own retry/repair/resume state."
  },
  "servers": [{"url": "http://127.0.0.1:8080", "description": "Local reference server"}],
  "paths": {
    "/v1/evaluate/transition/guarded": {
      "post": {
        "operationId": "evaluateGuardedResponsibilityTransition",
        "summary": "Evaluate a guarded M3 responsibility transition",
        "description": "Runs the strict governed M2 baseline, caller-declared risk conditions, configuration/relationship comparisons, and Human Return destination-readiness observations. Policy consequences must be explicitly supplied through required_controls. No authority or execution effect is created.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GuardedEvaluateRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Bounded guarded evaluation and responsibility-transition metadata",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GuardedEvaluateResponse"}}}
          },
          "400": {
            "description": "Malformed JSON or non-object request body",
            "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ControlAction": {
        "type": "string",
        "enum": ["allow_with_constraints", "route", "require_evidence", "require_authority", "downgrade_autonomy", "sandbox", "observe_only", "budget_limit", "isolate", "handoff", "hold", "deny", "emergency_stop"]
      },
      "IdentityMap": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string", "minLength": 1}
      },
      "IntegrityCheck": {
        "type": "object",
        "required": ["check_id", "kind", "expected"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["configuration", "relationship"]},
          "expected": {"$ref": "#/components/schemas/IdentityMap"},
          "observed": {"oneOf": [{"$ref": "#/components/schemas/IdentityMap"}, {"type": "null"}]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      },
      "EvidenceScope": {
        "type": "object",
        "required": ["available", "missing"],
        "properties": {
          "available": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "missing": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      },
      "HumanReturnCheck": {
        "type": "object",
        "required": ["return_id", "owner_role", "capability_status", "response_window_status", "next_decision_scope", "evidence_scope"],
        "properties": {
          "return_id": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "authority_reference": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "capability_status": {"type": "string", "enum": ["available", "limited", "unknown"]},
          "response_window_status": {"type": "string", "enum": ["available", "limited", "expired", "unknown"]},
          "next_decision_scope": {"type": "string", "minLength": 1},
          "evidence_scope": {"$ref": "#/components/schemas/EvidenceScope"}
        },
        "additionalProperties": false
      },
      "GuardEntryIntegrity": {
        "type": "object",
        "required": ["check", "required_controls"],
        "properties": {
          "check": {"$ref": "#/components/schemas/IntegrityCheck"},
          "required_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/components/schemas/ControlAction"}}
        },
        "additionalProperties": false
      },
      "GuardEntryHumanReturn": {
        "type": "object",
        "required": ["check", "required_controls"],
        "properties": {
          "check": {"$ref": "#/components/schemas/HumanReturnCheck"},
          "required_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/components/schemas/ControlAction"}}
        },
        "additionalProperties": false
      },
      "GuardedEvaluateRequest": {
        "type": "object",
        "required": ["contract_version", "governed_evaluation"],
        "properties": {
          "contract_version": {"const": "0.2.0-exp"},
          "governed_evaluation": {"type": "object", "additionalProperties": true},
          "risk_graph": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
          "integrity_checks": {"type": "array", "items": {"$ref": "#/components/schemas/GuardEntryIntegrity"}},
          "human_return_checks": {"type": "array", "items": {"$ref": "#/components/schemas/GuardEntryHumanReturn"}},
          "requested_route": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
          "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      },
      "IntegrityObservation": {
        "type": "object",
        "required": ["contract_version", "status", "comparison_scope", "independent_authentication_claim", "authority_effect"],
        "properties": {
          "contract_version": {"const": "0.1.0-exp"},
          "status": {"type": "string", "enum": ["clear", "triggered", "unknown", "invalid"]},
          "comparison_scope": {"const": "caller_supplied_identity_comparison_only"},
          "independent_authentication_claim": {"const": false},
          "authority_effect": {"const": "none"}
        },
        "additionalProperties": true
      },
      "HumanReturnObservation": {
        "type": "object",
        "required": ["contract_version", "readiness", "authority_effect", "human_decision_effect", "authority_validity_claim", "capability_validity_claim", "evidence_truth_claim", "assessment_scope"],
        "properties": {
          "contract_version": {"const": "0.1.0-exp"},
          "readiness": {"type": "string", "enum": ["ready_for_review", "conditional", "unresolved", "invalid"]},
          "authority_effect": {"const": "none"},
          "human_decision_effect": {"const": "none"},
          "authority_validity_claim": {"const": false},
          "capability_validity_claim": {"const": false},
          "evidence_truth_claim": {"const": false},
          "assessment_scope": {"const": "caller_supplied_return_readiness_only"}
        },
        "additionalProperties": true
      },
      "GuardObservations": {
        "type": "object",
        "required": ["integrity_results", "human_return_results"],
        "properties": {
          "integrity_results": {"type": "array", "items": {"$ref": "#/components/schemas/IntegrityObservation"}},
          "human_return_results": {"type": "array", "items": {"$ref": "#/components/schemas/HumanReturnObservation"}}
        },
        "additionalProperties": false
      },
      "GuardedEvaluateResponse": {
        "type": "object",
        "required": ["contract_version", "evaluation_result", "guard_observations", "risk_condition_result", "transition_result", "authority_effect", "execution_effect"],
        "properties": {
          "contract_version": {"const": "0.2.0-exp"},
          "evaluation_result": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
          "guard_observations": {"$ref": "#/components/schemas/GuardObservations"},
          "risk_condition_result": {"oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]},
          "transition_result": {"type": "object", "additionalProperties": true},
          "authority_effect": {"const": "none"},
          "execution_effect": {"const": "none"}
        },
        "additionalProperties": false
      }
    }
  }
}
